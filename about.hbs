<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline'">
  <title>AC Control — dependency licenses</title>
  <style>
    body { max-width: 76ch; margin: 2rem auto; padding: 0 1rem; font: 16px/1.6 system-ui, sans-serif; }
    pre { white-space: pre-wrap; overflow-wrap: anywhere; font: 14px/1.5 monospace; }
    section { border-top: 1px solid #aaa; margin-top: 2rem; padding-top: 1rem; }
    @media print { section { break-before: page; } }
  </style>
</head>
<body>
  <h1>AC Control dependency licenses</h1>
  <p>Generated from the locked Rust dependencies for this build. Keep this file with
  THIRD_PARTY_NOTICES.md, which retains notices for the protocol reference sources.</p>
  {{#each licenses}}
  <section>
    <h2>{{name}}</h2>
    <p>Used by:</p>
    <ul>
      {{#each used_by}}
      <li>{{crate.name}} {{crate.version}}</li>
      {{/each}}
    </ul>
    <pre>{{text}}</pre>
  </section>
  {{/each}}
</body>
</html>
